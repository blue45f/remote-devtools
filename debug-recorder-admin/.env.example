# ═══════════════════════════════════════════════════════════════════════════════
# Debug Recorder Admin - 환경 설정
# ═══════════════════════════════════════════════════════════════════════════════
#
# 이 파일을 `.env`로 복사하고 환경에 맞게 값을 설정하세요.
#
# [필수] 표시가 있는 변수는 반드시 설정해야 합니다
# [선택] 표시가 있는 변수는 기본값이 있습니다
#
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
# API 설정
# ───────────────────────────────────────────────────────────────────────────────

# [필수] Debug Recorder API 서버 기본 URL
# 사용자 데이터, 티켓, 대시보드 통계를 처리하는 메인 백엔드 API입니다
#
# 예시:
#   개발: http://localhost:3000
#   스테이징: https://api-staging.your-domain.com
#   프로덕션: https://api.your-domain.com
#
VITE_API_BASE_URL=http://localhost:3000


# ───────────────────────────────────────────────────────────────────────────────
# 인증 설정
# ───────────────────────────────────────────────────────────────────────────────

# [선택] Admin BFF (Backend For Frontend) 호스트 URL
# 세션 관리 및 인증에 사용됩니다
# 설정하지 않으면 인증 없이 실행됩니다 (로컬 개발 모드)
#
# 예시:
#   개발: http://localhost:4000
#   스테이징: https://auth-staging.your-domain.com
#   프로덕션: https://auth.your-domain.com
#
VITE_ADMIN_BFF_HOST=


# ───────────────────────────────────────────────────────────────────────────────
# 애플리케이션 설정
# ───────────────────────────────────────────────────────────────────────────────

# [선택] 헤더와 브라우저 탭에 표시되는 애플리케이션 제목
# 기본값: "Debug Recorder"
#
VITE_APP_TITLE=Debug Recorder

# [선택] 화면에서 표시되는 제품명/브랜딩 단어
# 화면 문구에서 벤더 이름이 아닌 조직 내 용어를 사용하려면 아래 값을 변경하세요.
#
VITE_APP_NAME=Debug Recorder


# [선택] Debug Recorder SDK가 호스팅된 URL
# 이 URL은 개발자 가이드에서 SDK 연동 안내에 표시됩니다
#
# 예시:
#   CDN: https://cdn.your-domain.com/sdk/index.umd.js
#   정적: https://static.your-domain.com/debug-recorder/sdk.js
#
VITE_SDK_URL=https://your-domain.com/sdk/index.umd.js

# [선택] 화면에서 보이는 SDK 명칭
# 예시: "디버그 SDK", "세션 SDK"
#
VITE_SDK_NAME=SDK

# [선택] Remote DevTools 연동
#
# VITE_REMOTE_DEVTOOLS_ENABLED: `true` 로 설정하면 관리자 대시보드에 Remote DevTools 탭이 노출됩니다.
# VITE_REMOTE_DEVTOOLS_API_BASE: 백엔드의 Remote DevTools API prefix
# VITE_REMOTE_DEVTOOLS_WS_URL: 이벤트 스트림 WebSocket URL
#   - 비워두면 API_BASE_URL을 기반으로 기본값을 사용합니다.
# VITE_REMOTE_DEVTOOLS_MAX_EVENTS: 화면에 보관할 최대 이벤트 개수
#
VITE_REMOTE_DEVTOOLS_ENABLED=true
VITE_REMOTE_DEVTOOLS_API_BASE=/api/remote-devtools
VITE_REMOTE_DEVTOOLS_WS_URL=
VITE_REMOTE_DEVTOOLS_MAX_EVENTS=250

# [선택] 이슈/티켓 시스템 표시명
# 특정 조직의 도구명을 하드코딩하고 싶지 않을 때 사용합니다.
#
VITE_ISSUE_TRACKER_NAME=이슈 추적 시스템
VITE_ISSUE_LABEL=이슈
VITE_ISSUE_PROJECT_KEY_LABEL=프로젝트 키
VITE_ISSUE_PREFIX_LABEL=제목 접두어

# [선택] 공유/알림 채널, 디자인 툴, 스프레드시트명칭
#
VITE_SHARE_CHANNEL_NAME=알림 채널
VITE_DESIGN_TOOL_NAME=디자인 툴
VITE_SPREADSHEET_LABEL=스프레드시트


# ───────────────────────────────────────────────────────────────────────────────
# 자산 설정
# ───────────────────────────────────────────────────────────────────────────────

# [선택] 원격 아이콘 기본 URL
# 설정하면 번들된 자산 대신 이 URL에서 아이콘을 로드합니다
# 비워두면 로컬/번들된 아이콘을 사용합니다
#
# 예시:
#   CDN: https://cdn.your-domain.com/icons
#
VITE_ICON_BASE_URL=


# ───────────────────────────────────────────────────────────────────────────────
# Google Sheets 연동
# ───────────────────────────────────────────────────────────────────────────────

# [선택] TC 가져오기용 기본 Google Sheet 탭/시트 이름
# Google Sheets에서 티켓 템플릿 데이터를 로드할 때 이 탭 이름이 기본값으로 사용됩니다
# 기본값: "DebugRecorder"
#
VITE_DEFAULT_SHEET_NAME=DebugRecorder


# ───────────────────────────────────────────────────────────────────────────────
# 개발 설정
# ───────────────────────────────────────────────────────────────────────────────

# [선택] 개발 서버 호스트
# 특정 호스트명에서 개발 서버에 접근해야 하는 경우 변경하세요
# 기본값: "localhost"
#
# 예시:
#   localhost           - 표준 로컬 개발
#   0.0.0.0             - 외부 접근 허용 (예: 모바일 테스트)
#   dev.local           - 커스텀 로컬 도메인 (/etc/hosts 항목 필요)
#
VITE_DEV_HOST=localhost


# ═══════════════════════════════════════════════════════════════════════════════
# 빠른 시작 설정 예시
# ═══════════════════════════════════════════════════════════════════════════════
#
# === 로컬 개발 (최소 설정) ===
#
# VITE_API_BASE_URL=http://localhost:3000
#
# === 스테이징 환경 ===
#
# VITE_API_BASE_URL=https://api-staging.example.com
# VITE_ADMIN_BFF_HOST=https://auth-staging.example.com
# VITE_APP_TITLE=Debug Recorder (스테이징)
# VITE_SDK_URL=https://cdn-staging.example.com/sdk/index.umd.js
#
# === 프로덕션 환경 ===
#
# VITE_API_BASE_URL=https://api.example.com
# VITE_ADMIN_BFF_HOST=https://auth.example.com
# VITE_APP_TITLE=Debug Recorder
# VITE_SDK_URL=https://cdn.example.com/sdk/index.umd.js
# VITE_ICON_BASE_URL=https://cdn.example.com/icons
#
# ═══════════════════════════════════════════════════════════════════════════════
