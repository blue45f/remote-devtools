{
  "name": "debug-recorder-admin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Admin dashboard for Debug Recorder - A web debugging and ticket management tool",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run test && vite build && pnpm run build:budget",
    "build:budget": "node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@tanstack/react-query": "^5.100.14",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "react-router-dom": "^7.16.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
