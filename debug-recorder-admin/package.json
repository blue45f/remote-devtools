{
  "name": "debug-recorder-admin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Admin dashboard for Debug Recorder - A web debugging and ticket management tool",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run build:budget",
    "build:budget": "node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.11",
    "antd": "^6.0.1",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-router": "^7.9.6",
    "react-router-dom": "^7.10.1",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.5.1",
    "vite-plugin-mkcert": "^1.17.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.7.3",
    "typescript": "5.9.3",
    "vite": "^7.2.6"
  }
}
