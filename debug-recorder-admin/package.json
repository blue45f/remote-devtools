{
  "name": "debug-recorder-admin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Admin dashboard for Debug Recorder - A web debugging and ticket management tool",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run build:budget",
    "build:budget": "node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@tanstack/react-query": "^5.100.14",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-router": "^7.16.0",
    "react-router-dom": "^7.16.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "6.0.3",
    "vite": "^8.0.14"
  }
}
