# ──────────────────────────────────────────────────────────────────────
# Client environment variables
# ──────────────────────────────────────────────────────────────────────

# ── Mode 1: Public demo (no backend required) ──
# Uncomment to force demo mode for all visitors (seed data, no backend).
# VITE_FORCE_DEMO=true

# ── Mode 2: Production (connected to real backend) ──
# Point these at the running backend servers.
# VITE_HOST=https://api.your-domain.com
# VITE_WS_HOST=wss://ws.your-domain.com

# ── Mode 3: Dynamic (default) ──
# When neither VITE_FORCE_DEMO nor VITE_HOST is set, the client tries
# to connect to the backend via same-origin /api routes (proxied by
# Vite dev server or nginx). If the backend is unreachable, the UI
# gracefully offers demo mode activation.

# ── Observability (optional) ──
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=
